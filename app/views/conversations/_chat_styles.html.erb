<%# Chat bubble styling, shared by the transcript (show) and the new-conversation page (index). %>
<style>
  .chat-msg { display: block; padding: 10px 14px; margin: 8px 0; max-width: 85%; border-radius: 14px; }
  .chat-msg p { margin: 0; white-space: pre-wrap; }
  .chat-msg.user { margin-left: auto; background: #0ea5e9; color: #fff; }
  .chat-msg.assistant { margin-right: auto; background: #f1f5f9; color: #0f172a; }

  /* Animated dots shown while the coach's reply is in flight. */
  .chat-msg .typing { display: flex; gap: 4px; align-items: center; height: 1.25rem; }
  .chat-msg .typing span { width: 7px; height: 7px; border-radius: 50%; background: #94a3b8; animation: typing-bounce 1.2s infinite ease-in-out; }
  .chat-msg .typing span:nth-child(2) { animation-delay: 0.2s; }
  .chat-msg .typing span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes typing-bounce {
    0%, 60%, 100% { opacity: 0.35; transform: translateY(0); }
    30%           { opacity: 1;    transform: translateY(-4px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat-msg .typing span { animation: none; opacity: 0.6; }
  }
</style>
